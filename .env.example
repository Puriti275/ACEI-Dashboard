# --- Airtable (system of record) ---
# Personal access token with data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# --- Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Deployed origin, e.g. https://acei-dashboard.vercel.app (omit for local dev)
AUTH_URL=

# --- Admin allow-list (no database) ---
# Comma-separated "email:base64Hash" pairs. Everyone here can sign in.
# Generate a hash:  node scripts/hash-password.mjs 'their-password'
ACEI_ADMINS=alice@utk.edu:JDJiJDEwJHJlcGxhY2Vfd2l0aF9yZWFsX2hhc2g
# Comma-separated emails. Subset of the above that also gets person-level student data.
ACEI_SUPER_ADMINS=alice@utk.edu

# --- Cache revalidation ---
# Used by the daily Vercel Cron job (GET /api/revalidate?secret=...)
REVALIDATE_SECRET=
# Vercel Cron -> route handler auth (falls back to REVALIDATE_SECRET if unset)
CRON_SECRET=
